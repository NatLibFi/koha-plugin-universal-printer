[% USE raw %]
[% USE Asset %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: [% metadata.plugin_name %]: Print report</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

[% USE Branches %]
[% USE AuthorisedValues %]
[% USE ItemTypes %]
[% PROCESS 'html_helpers.inc' %]

[% INCLUDE 'plugin_breadcrumbs.inc' active_text='Print report' %]

<div class="main container-fluid">

    <div class="page-header">
        <h2>[% metadata.plugin_name %] Print report</h2>
    </div>

    [% WRAPPER tabs id= "universalprintreport" %]
        [% WRAPPER tabs_nav %]

            [% WRAPPER tab_item tabname= "reports" bt_active= 1 %]
                <span>SQL Reports</span>
            [% END %]

            [% WRAPPER tab_item tabname= "labelsbatches" %]
                <span>Labels</span>
            [% END %]

            [% WRAPPER tab_item tabname= "holdsqueue" %]
                <span>Holds queue</span>
            [% END %]

        [% END # /WRAPPER tabs_nav %]
        [% WRAPPER tab_panels %]

            [% WRAPPER tab_panel tabname="reports" bt_active= 1 %]
                [% INCLUDE "reports/form_reports.inc" %]
            [% END # /tab_panel# %]

            [% WRAPPER tab_panel tabname="labelsbatches" %]
                [% INCLUDE "reports/form_labelsbatches.inc" %]
            [% END # /tab_panel# %]

            [% WRAPPER tab_panel tabname="holdsqueue" %]
                [% INCLUDE "reports/form_holdsqueue.inc" %]
            [% END # /tab_panel# %]

        [% END # /WRAPPER tab_panels %]
    [% END # /WRAPPER tabs %]

[% INCLUDE 'intranet-bottom.inc' %]
